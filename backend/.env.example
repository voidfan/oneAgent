# xAgent Configuration
APP_NAME=xAgent
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=postgresql+asyncpg://xagent:xagent@db:5432/xagent

# Redis
REDIS_URL=redis://redis:6379/0

# ==================== LLM 配置 (4 个核心配置项) ====================
# API 提供商 (如: openai, anthropic, deepseek, ollama, openrouter, google_gemini 等)
LLM_PROVIDER=openai
# API Base URL (留空则使用提供商默认地址)
LLM_BASE_URL=
# API 密钥
LLM_API_KEY=sk-your-key-here
# 模型名称
LLM_MODEL=gpt-4o

# Agent
MAX_AGENT_STEPS=50
AGENT_TIMEOUT_SECONDS=300
MAX_CONCURRENT_AGENTS=10

# Security
TOOL_SANDBOX_ENABLED=true

# Observability
LOG_LEVEL=INFO
ENABLE_TRACING=true
PROMETHEUS_ENABLED=true
