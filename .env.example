# ==================== Database ====================
POSTGRES_DB=xagent
POSTGRES_USER=xagent
POSTGRES_PASSWORD=xagent_secret

# ==================== LLM 配置 (4 个核心配置项) ====================
# API 提供商 (可选值见 UI 设置页面，如: openai, anthropic, deepseek, ollama, openrouter 等)
LLM_PROVIDER=openai
# API Base URL (留空则使用提供商默认地址)
LLM_BASE_URL=
# API 密钥
LLM_API_KEY=sk-your-api-key-here
# 模型名称
LLM_MODEL=gpt-4o

# ==================== Logging ====================
LOG_LEVEL=INFO
